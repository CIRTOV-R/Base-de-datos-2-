    "zod": "3.25.76",
    "lucide-react": "0.553.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
