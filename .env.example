# Base de datos PostgreSQL (local o hosted: Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://usuario:password@127.0.0.1:5432/ecomarket_vital?schema=public"

# Secreto para firmar cookies y estados OAuth (generar con: openssl rand -hex 32)
AUTH_SECRET="cambia_este_valor_en_produccion"

# URL publica de la aplicacion
APP_URL="http://localhost:3000"

# WebAuthn / biometria
WEBAUTHN_RP_NAME="EcoMarket Vital"

# SSO Google (opcional; crear en https://console.cloud.google.com/apis/credentials)
# Redirect URI: ${APP_URL}/api/auth/sso/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
